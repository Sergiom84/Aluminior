{
  "name": "aluminior",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestion para carpinteria de aluminio y PVC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "db:generate": "npm run -w @aluminior/db generate",
    "db:migrate": "npm run -w @aluminior/db migrate",
    "etl": "npm run -w @aluminior/etl import",
    "etl:tarifa": "tsx packages/etl/src/cargar-tarifa.ts",
    "etl:cortes:local": "tsx packages/etl/src/cargar-cortes-local.ts",
    "etl:catalogo-despiece:local": "tsx packages/etl/src/cargar-catalogo-despiece-local.ts",
    "etl:motor-catalogo": "tsx packages/etl/src/cargar-motor-catalogo.ts",
    "dev": "npm run dev:web",
    "dev:web": "npm run -w @aluminior/web dev",
    "test": "npm run -ws --if-present test",
    "test:ci": "npm run -ws --if-present test -- --maxWorkers=2",
    "typecheck": "npm run -ws --if-present typecheck",
    "check:architecture": "node scripts/auditar-modularidad.mjs",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.5": true
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "vite": "6.4.3",
    "next": {
      "sharp": "0.35.5",
      "postcss": "8.5.23"
    },
    "source-map-js": "1.2.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "packageManager": "npm@10.9.8"
}
